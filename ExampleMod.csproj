<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>AdventurersEra.ExampleMod</AssemblyName>
    <RootNamespace>ExampleMod</RootNamespace>
    <!-- The manifest is the single source of the mod version. -->
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/module.json')), '&quot;version&quot;\s*:\s*&quot;([^&quot;]+)&quot;').Groups[1].Value)</Version>
    <PackageName>ExampleMod</PackageName>
    <PackageDirectory>$(MSBuildProjectDirectory)/dist/package/$(PackageName)-$(Version)</PackageDirectory>
    <PackageArchive>$(MSBuildProjectDirectory)/dist/$(PackageName)-$(Version).zip</PackageArchive>
    <!-- Use the first available API DLL: SDK folder, project root, then legacy SDK layout. -->
    <ModdingApiPath Condition="'$(ModdingApiPath)' == '' and Exists('$(MSBuildProjectDirectory)/SDK/TAE.SDK.dll')">$(MSBuildProjectDirectory)/SDK/TAE.SDK.dll</ModdingApiPath>
    <ModdingApiPath Condition="'$(ModdingApiPath)' == '' and Exists('$(MSBuildProjectDirectory)/TAE.SDK.dll')">$(MSBuildProjectDirectory)/TAE.SDK.dll</ModdingApiPath>
    <ModdingApiPath Condition="'$(ModdingApiPath)' == '' and Exists('$(MSBuildProjectDirectory)/SDK/References/TAE.SDK.dll')">$(MSBuildProjectDirectory)/SDK/References/TAE.SDK.dll</ModdingApiPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);SDK/**;TAE.SDK.dll;dist/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="AdventurersEra.Modding.Api">
      <HintPath>$(ModdingApiPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Compile Include="src/**/*.cs" />
    <ModAsset Include="assets/**/*" />
  </ItemGroup>
  <Target Name="CheckSdk" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(ModdingApiPath)' == '' or !Exists('$(ModdingApiPath)')" Text="Game SDK is missing. Place TAE.SDK.dll in SDK/, next to ExampleMod.csproj, or in SDK/References/." />
    <Message Importance="high" Text="Game SDK: $(ModdingApiPath)" />
  </Target>
  <Target Name="PackageMod" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageDirectory)/Code" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/module.json" DestinationFolder="$(PackageDirectory)" />
    <Copy SourceFiles="@(ModAsset)" DestinationFiles="@(ModAsset->'$(PackageDirectory)/assets/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Importance="high" Text="Ready-to-install mod: $(PackageDirectory)" />
  </Target>
  <Target Name="ArchiveMod" AfterTargets="PackageMod">
    <PropertyGroup>
      <_ArchiveRoot>$(MSBuildProjectDirectory)/obj/mod-archive</_ArchiveRoot>
    </PropertyGroup>
    <RemoveDir Directories="$(_ArchiveRoot)" />
    <ItemGroup>
      <_PackageFile Include="$(PackageDirectory)/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PackageFile)" DestinationFiles="@(_PackageFile->'$(_ArchiveRoot)/$(PackageName)-$(Version)/%(RecursiveDir)%(Filename)%(Extension)')" />
    <ZipDirectory SourceDirectory="$(_ArchiveRoot)" DestinationFile="$(PackageArchive)" Overwrite="true" />
    <Message Importance="high" Text="Archive: $(PackageArchive)" />
  </Target>
</Project>
